# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Build artifacts
/bin/
/dist/
*.test

# Secrets / keys — NEVER commit
*.env
.env
.env.*
!*.env.example
*.key
*.pem
identity.key
identity.key.pub
vault.db
*.vault
cosign.key
cosign.pub
secrets.*.yaml

# Local / generated toolchain manifests (produced by `opslify init`)
/devbox.json
/flake.nix
/flake.lock
/opslify.env.yaml

# Specs and docs live here in the tree, next to the code they describe.
# Only the generated MkDocs output is ignored.
/site/

# Docs build venv
/.venv/

# Claude Code session state
.claude/

# Scratch / external-tool experiments
cline-test/

# Compiled binaries — build them, never commit them.
#
# Listed as explicit PATHS, one per place a build actually drops one. The obvious
# shorthand is the binary's bare name, which matches at any depth — and also
# matches the SOURCE DIRECTORIES cmd/opslify/ and cmd/opslify-tower/, quietly
# ignoring every new file in them. A rule that hides the code it was meant to
# protect is worse than the 31MB it was written to stop.
/daemon/opslifyd
/daemon/opslify
/daemon/opslify-tower
/daemon/cmd/opslifyd/opslifyd
/daemon/cmd/opslify/opslify
/daemon/cmd/opslify-tower/opslify-tower
