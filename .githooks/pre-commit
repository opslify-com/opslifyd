#!/bin/sh
# Opslifyd pre-commit hook — the anti-hallucination gate.
# Regenerates the deterministic requirements graph and refuses the commit if the
# spec has a dependency cycle, a dangling Depends on:/Blocks:, or a missing feature.
#
# Enabled via:  git config core.hooksPath .githooks   (done by spec/tools/setup-git.sh)

set -e

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found — cannot validate spec graph." >&2
    exit 1
fi

# Regenerate graph.json + graph.mmd from the feature files, and validate.
if ! python3 spec/tools/specgraph.py; then
    echo "pre-commit: spec graph validation FAILED — fix the dependency errors above before committing." >&2
    exit 1
fi

# Keep the generated artifacts in sync with the spec in the same commit.
git add spec/graph.json spec/graph.mmd 2>/dev/null || true

exit 0
